@page "/1A-8"
@inherits CalcPage
@using AlcoCalc.Services
@using AlcoCalc.Values

<PageTitle>1A-8</PageTitle>

<h1 class="centerHorizontally mt-15-mobile">1A-8</h1>

<p role="status" class="centerHorizontally">1A-8: Výpočet hustoty a merného objemu vody.</p>

<MudStack Class="mx-5">
    <MudTextField @ref="waterTemperatureInput" T="string" Variant="Variant.Outlined" Pattern="[0-9.,\-+]*" Immediate="true" InputMode="@(InputMode.numeric)"
                  HelperText="@($"od {Calculator1A_8.WaterTemperatureMin} do {Calculator1A_8.WaterTemperatureMax}")" Label="Teplota vody [°C]"
                  Value="@waterTemperature"
                  ValueChanged="OnWaterTemperatureChanged" OnBlur="OnWaterTemperatureBlur" OnKeyDown="OnWaterTemperatureKeyDown" />
                     
    <MudPaper Class="pa-0 my-0" Outlined="true">
        <MudTextField @ref="result" ReadOnly="true"
                      Value="@WaterDensityStr" Label="Hustota vody [kg/m^3]" Variant="Variant.Outlined"
                      OnKeyDown="OnResultKeyDown"/>
        <MudTextField @ref="result2" ReadOnly="true"
                      Value="@ResultStr" Label="Merný objem vody [m^3/kg]" Variant="Variant.Outlined"
                      OnKeyDown="OnResult2KeyDown"/>
    </MudPaper>
</MudStack>
