@page "/1A-2/help"
@inherits HelpPage
@using AlcoCalc.Components

<PageTitle>1A-2</PageTitle>

<div class="density-page">
    <article class="density-document">
        
        <h2>
            Tab. 1A – 2
        </h2>
        <h1>
            Prepočet hmotnostného zlomku etanolu na objemovú koncentráciu pri 20 °C
        </h1>

        <p>
            Pre výpočet objemovej koncentrácie pri 20 °C (<i>σ</i><sub>E</sub>) zo známeho hmotnostného
            zlomku etanolu (<i>w</i><sub>E</sub>) platí:
        </p>

        <section class="formula-section">
            <Formula FormulaLatex="\sigma_E = w_E \times \frac{\rho_{20}}{\rho_E}" />
        </section>

        <p>Kde:</p>

        <ul>
            <li>
                <i>ρ</i><sub>E</sub> – hustota etanolu pri 20 °C (<i>ρ</i><sub>E</sub> = 789,24 kg/m³);
            </li>
            <li>
                <i>ρ</i><sub>20</sub> – hustota liehu (zmesi) pri 20 °C.
            </li>
        </ul>

        <p>
            Vzorec bol prevzatý z odporúčania OIML R 22, čl. 4, vzorec k Tab. III b.
        </p>

    </article>
</div>
