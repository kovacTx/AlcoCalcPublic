@page "/1A-3/help"
@inherits HelpPage
@using AlcoCalc.Components

<PageTitle>1A-3</PageTitle>

<div class="density-page">
    <article class="density-document">
        
        <h2>
            Tab. 1A – 3
        </h2>
        <h1>
            Prepočet objemovej koncentrácie pri 20 °C na hmotnostný zlomok etanolu
        </h1>

        <p>
            Pre výpočet hmotnostného zlomku etanolu (<i>w</i><sub>E</sub>) zo známej objemovej koncentrácie
            pri 20 °C (<i>σ</i><sub>E</sub>) platí:
        </p>

        <section class="formula-section">
            <Formula FormulaLatex="w_E = \sigma_E \times \frac{\rho_E}{\rho_{20}}" />
        </section>

        <p>
            Vzťah je odvodený z predchádzajúceho vzorca (Tab. 1A – 2). Význam symbolov je rovnaký.
        </p>

    </article>
</div>
