@page "/1A-4/help"
@inherits HelpPage
@using AlcoCalc.Components

<PageTitle>1A-4</PageTitle>

<div class="density-page">
    <article class="density-document">
        
        <h2>
            Tab. 1A – 4
        </h2>
        <h1>
            Výpočet korekcie na tepelnú rozťažnosť pyknometra
        </h1>

        <p>
            Tabuľka slúži na určenie korekčného súčiniteľa <i>F</i><sub>b</sub> na teplotnú rozťažnosť materiálu
            pyknometra, počítaného podľa vzťahu:
        </p>

        <section class="formula-section">
            <Formula FormulaLatex="F_b = 1 - \beta_s \times (t - t_{0s})" />
        </section>

        <p>Kde:</p>

        <ul>
            <li>
                <i>β</i><sub>s</sub> – teplotný súčiniteľ objemovej rozťažnosti materiálu pyknometra v °C⁻¹
            </li>
            <li>
                <i>t</i> – teplota merania v °C
            </li>
            <li>
                <i>t</i><sub>0S</sub> – referenčná teplota pyknometra, <i>t</i><sub>0S</sub> = 20 °C.
            </li>
        </ul>

    </article>
</div>
