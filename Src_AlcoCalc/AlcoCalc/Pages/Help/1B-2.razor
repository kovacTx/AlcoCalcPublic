@page "/1B-2/help"
@inherits HelpPage
@using AlcoCalc.Components

<PageTitle>1B-2</PageTitle>

<div class="density-page">
    <article class="density-document">
        
        <h2>
            Tab. 1B-2
        </h2>
        <h1>
            Výpočet objemovej koncentrácie pri 20 °C z údaja liehomera
        </h1>

        <p>
            Hodnoty objemovej koncentrácie etanolu pri 20 °C v závislosti od údaja liehomera v rozsahu (0 až 100) % a od zmeranej teploty
            liehu v rozsahu (0 až 30) °C boli prevzaté z ON 66 0808 (zodpovedá tabuľke 1B – 2 v prílohe č. 4 k výnosu).
        </p>

        <p>
            Korekcie na zmenu objemu liehomera a na zmenu povrchového napätia s teplotou sú v tabuľke už zahrnuté.
        </p>

        <section class="formula-section">
            <p><strong>Vstupné údaje</strong></p>

            <ul>
                <li>
                    <i>L</i> – údaj liehomera v rozsahu 0 až 100 %;
                </li>
                <li>
                    <i>t</i> – zmeraná teplota liehu v rozsahu 0 až 30 °C.
                </li>
            </ul>

            <p>
                Objemová koncentrácia etanolu pri 20 °C sa určuje z príslušnej tabuľkovej hodnoty podľa údaja liehomera
                a zmeranej teploty liehu.
            </p>
        </section>

    </article>
</div>
